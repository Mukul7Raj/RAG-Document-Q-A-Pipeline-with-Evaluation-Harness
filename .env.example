# -------------------------------------------------------------
# RAG Document Q&A Pipeline Configuration
# ---------------------------------------------
# Optional: Provide OpenAI API Key for GPT-4o-mini generation.
# If omitted, pipeline automatically falls back to deterministic local mock generation.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
# OPENAI_API_BASE=http://localhost:11434/v1  # Uncomment for Ollama or LocalAI

# Embedding Provider: 'huggingface' (default), 'openai', or 'mock'
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
NORMALIZE_EMBEDDINGS=true

# Chunking Defaults
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
DEFAULT_CHUNK_STRATEGY=recursive

# Vector Search Defaults
DEFAULT_TOP_K=4
SIMILARITY_THRESHOLD=0.35
USE_MMR=false
MMR_DIVERSITY_LAMBDA=0.7

# Guardrails & Validation
ENABLE_OUTPUT_VALIDATION=true
STRICT_GROUNDING=true
HALLUCINATION_THRESHOLD=0.65
